# Copy this file to .env and fill in your own values.
# .env is git ignored and never committed.

# Public base URL of the site, used in page templates.
URL=localhost:5000

# Set to "true" to run the app against an in-memory SQLite database
# instead of MySQL. run_test.sh sets this automatically.
TESTING=false

# MySQL / MariaDB connection. MYSQL_HOST is the docker compose service name.
MYSQL_HOST=mysql
MYSQL_USER=myportfolio
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=myportfoliodb

# Used by the mariadb container to initialise the root account.
MYSQL_ROOT_PASSWORD=changeme-root
